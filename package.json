{
    "name": "moesekai-root",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "dev": "npm run dev --prefix web",
        "build": "npm run build --prefix web",
        "start": "npm run start --prefix web",
        "lint": "npm run lint --prefix web",
        "version:show": "node web/scripts/resolve-version.mjs",
        "version:next": "node web/scripts/resolve-version.mjs --next-tag patch"
    },
    "workspaces": [
        "web"
    ],
    "overrides": {
        "@babel/core": "7.29.6",
        "brace-expansion@1.x": "1.1.16",
        "brace-expansion@2.x": "2.1.2",
        "brace-expansion@5.x": "5.0.7",
        "eslint-plugin-react-hooks": "7.0.1",
        "js-yaml@4.x": "4.3.0",
        "picomatch@4.x": "4.0.4",
        "postcss": "8.5.22",
        "sharp": "0.35.3"
    }
}
