# Complete public object-store directory. It includes the bucket path and is
# embedded at build time. Example: https://assets.pjsk.moe/sekai-extra-assets/
NEXT_PUBLIC_MOLY_RESOURCE_BASE=

# Legacy CDN mapping of /moly/ at a bare HTTPS origin. Leave empty when BASE
# is set; if both are supplied their origins must match.
NEXT_PUBLIC_MOLY_RESOURCE_ORIGIN=

# Docker production: pass NEXT_PUBLIC_MOLY_RESOURCE_BASE with --build-arg.
# Next.js embeds NEXT_PUBLIC_* values at build time; docker run -e cannot change them.
# Direct Next.js development: copy the resource-base value to web/.env.local
# or export it before starting `bun run --cwd web dev`.
