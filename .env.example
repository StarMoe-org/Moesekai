# Optional override of the public Moly runtime and resource directory.
# Unset or empty uses https://assets.pjsk.moe/sekai-extra-assets/ from the source.
# An override includes the bucket path and ends in "/".
# HTTPS only, no query, fragment or credentials.
# Example: https://assets.example.com/bucket/
NEXT_PUBLIC_MOLY_RESOURCE_BASE=

# Docker production needs no variable for the default publication.
# To override it, pass NEXT_PUBLIC_MOLY_RESOURCE_BASE with --build-arg.
# Next.js embeds NEXT_PUBLIC_* values at build time; docker run -e cannot change them.
# Direct Next.js development: copy the resource-base value to web/.env.local
# or export it before starting `bun run --cwd web dev`.

# Live2D story player (sse-web, built from SekaiStoryExporter). Its release is
# in web/vendor/sse-web and needs no setting.
# Optional: a copy of live2dcubismcore.min.js (Cubism Core for Web) the site
# hosts itself. The release does not contain it; unset, the player loads it
# from Live2D's own address.
NEXT_PUBLIC_SSE_WEB_CORE_URL=
# Optional overrides of where episodes are read from. The story libraries are
# <LIBRARY_BASE>/<jp|cn|tw|kr|en>/ and the client unpacks <INAPP_BASE>/<unpack>/;
# the defaults are the published ones on assets.pjsk.moe. INAPPS says which
# unpack each server's stories are played with, as region=unpack pairs (default
# jp=jp-7.0.0,cn=cn-6.4.0,tw=cn-6.4.0,kr=cn-6.4.0,en=cn-6.4.0); a server left
# out has no Live2D playback.
NEXT_PUBLIC_SSE_WEB_LIBRARY_BASE=
NEXT_PUBLIC_SSE_WEB_INAPP_BASE=
NEXT_PUBLIC_SSE_WEB_INAPPS=
# The JP stories are drawn with open fonts kept in web/public/story-fonts
# (M PLUS 1 and Source Han Sans JP, SIL OFL 1.1), not with the JP client's own
# commercial typeface, which is then never fetched. Optional: another directory
# holding MPLUS1[wght].ttf, SourceHanSansJP-Medium.otf and
# SourceHanSansJP-Heavy.otf, with their licence next to them.
NEXT_PUBLIC_SSE_WEB_FONT_BASE=
# Set to 1 to draw the JP stories with the JP client's own fonts (a commercial
# typeface, read from the client unpack) instead of the open ones.
NEXT_PUBLIC_SSE_WEB_CLIENT_FONTS=
# Development only: a relay for the hosts above, which allow https://pjsk.moe
# alone across origins (SekaiStoryExporter's crates/sse-web/dev/serve.py serves
# one at http://127.0.0.1:8787/remote/).
NEXT_PUBLIC_SSE_WEB_ASSET_PROXY=
