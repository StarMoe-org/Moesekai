# Optional Moly artifact CDN. Leave empty for same-origin resources.
# Must be an HTTPS origin without a path, query, fragment, or credentials.
# Example: https://assets.example.com
NEXT_PUBLIC_MOLY_RESOURCE_ORIGIN=

# Used by `docker compose -f docker-compose.dev.yml up` only.
# Point at the same-origin publication/control-plane server reachable from web.
# This rewrite serves the manifest, SDK, stage shell and cache worker, not the CDN.
MOLY_DEV_ORIGIN=http://backend:8080

# Docker production: pass NEXT_PUBLIC_MOLY_RESOURCE_ORIGIN with --build-arg.
# Next.js embeds NEXT_PUBLIC_* values at build time; docker run -e cannot change them.
# Direct Next.js development: copy the resource-origin value to web/.env.local
# or export it before starting `bun run --cwd web dev`.
